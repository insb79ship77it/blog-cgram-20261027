---
import '../styles/global.css';
import { CATEGORIES, SITE_DESCRIPTION, SITE_NAME } from '../utils/posts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  current?: string;
}

const {
  title = SITE_NAME,
  description = SITE_DESCRIPTION,
  image,
  current,
} = Astro.props;

const pageTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
  </head>

  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="site-name" href="/">{SITE_NAME}</a>
        <nav aria-label="카테고리">
          <ul class="nav">
            {
              CATEGORIES.map((category) => (
                <li>
                  <a
                    href={`/category/${category.slug}/`}
                    aria-current={current === category.name ? 'page' : undefined}
                  >
                    {category.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
  <div class="wrap">
    <nav aria-label="사이트 정보">
      <ul class="footer-nav">
        <li><a href="/about/">소개</a></li>
        <li><a href="/privacy/">개인정보처리방침</a></li>
        <li><a href="/contact/">문의하기</a></li>
      </ul>
    </nav>
    <p>© 2026 {SITE_NAME}. 이 블로그의 글은 일반적인 정보 제공을 위한 것입니다.</p>
  </div>
</footer>
