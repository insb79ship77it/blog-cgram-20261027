---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { CATEGORIES, categorySlug, getSortedPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getSortedPosts();

  // 등록된 카테고리 + 글에서 새로 사용한 카테고리
  const names = [
    ...new Set([
      ...CATEGORIES.map((c) => c.name),
      ...posts.map((p) => p.data.category),
    ]),
  ];

  return names.map((name) => ({
    params: { slug: categorySlug(name) },
    props: {
      name,
      posts: posts.filter((p) => p.data.category === name),
    },
  }));
}

const { name, posts } = Astro.props;
---

<BaseLayout
  title={`${name} 글 모음`}
  description={`${name} 카테고리의 최신 글을 모아 봅니다.`}
  current={name}
>
  <section class="masthead compact">
    <h1>{name}</h1>
    <p>글 {posts.length}편</p>
  </section>

  <PostList posts={posts} />
</BaseLayout>
