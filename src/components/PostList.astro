---
import PostMeta from './PostMeta.astro';
import { postUrl, type Post } from '../utils/posts';
import { getThumbnail } from '../utils/thumbnail';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{
  posts.length ? (
    <ul class="post-list">
      {posts.map((post) => {
        const thumbnail = getThumbnail(post);
        const url = postUrl(post);

        return (
          <li class="post-item">
            {/* 이미지가 없어도 썸네일 영역은 유지하고 <img>만 생략합니다. */}
            <a class="post-thumb" href={url} aria-label={`${post.data.title} 글 보기`}>
              {thumbnail && (
                <img
                  src={thumbnail}
                  alt={post.data.title}
                  loading="lazy"
                  decoding="async"
                />
              )}
            </a>

            <div class="post-body">
              <PostMeta category={post.data.category} date={post.data.pubDate} />
              <h2 class="post-title">
                <a href={url}>{post.data.title}</a>
              </h2>
              <p class="post-desc">{post.data.description}</p>
              <TagList tags={post.data.tags} />
            </div>
          </li>
        );
      })}
    </ul>
  ) : (
    <p class="empty">
      아직 등록된 글이 없습니다. <code>src/content/posts/</code> 폴더에 Markdown
      파일을 추가하면 이곳에 표시됩니다.
    </p>
  )
}
